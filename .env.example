# Copier vers .env et adapter les valeurs :
#   cp .env.example .env
#
# Ne jamais committer le fichier .env.

ADMIN_TOKEN=change-me-admin-token
FLASK_SECRET_KEY=change-me-flask-secret

# Optionnel
# TRUST_LOOPBACK_AUTH=1
#   1 (défaut hors tests) : pas de saisie ADMIN_TOKEN sur 127.0.0.1
#   0 : toujours demander /auth ou X-Admin-Token
# APP_HOST=127.0.0.1
# APP_DEBUG=0
# SERVICE_DASHBOARD_HOST=127.0.0.1
# SERVICE_DASHBOARD_PORT=5500
# SERVICE_DASHBOARD_BROWSER=1
# BDC_URL=http://127.0.0.1:5000/
# REPORTING_URL=http://127.0.0.1:5010/
# RECONCILIATION_URL=http://127.0.0.1:5030/
# BILLING_URL=http://127.0.0.1:5040/
# BDC_MAX_PDF_FILES=200
# BDC_MAX_PDF_BYTES=20971520
# REPORTING_MAX_WORKERS=8
